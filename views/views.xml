<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     
   

    <!-- =================== Purchase Order =================== -->
    <record id="view_purchase_order_form_ou" model="ir.ui.view">
        <field name="name">purchase.order.form.ou</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
            
                <field name="allow_modify_ou_flag" invisible="1"/>
                <field name="allowed_ou_domain" invisible="1"/>

                <field name="operation_unit_id" force_save="1" domain="allowed_ou_domain"  readonly="not allow_modify_ou_flag" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
       
            </xpath>
        </field>
    </record>

    <!-- =================== Purchase Order tree =================== -->
    <record id="view_purchase_order_kpis_tree_ou" model="ir.ui.view">
        <field name="name">view_purchase_order_kpis_tree_ou</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr = "//field[@name = 'company_id']" position="after">
                    <field name="operation_unit_id"  optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>

        </field>
    </record>

    <record id="view_purchase_order_tree_ou" model="ir.ui.view">
        <field name="name">view_purchase_order_tree_ou</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr = "//field[@name = 'company_id']" position="after">
                    <field name="operation_unit_id"   optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>

        </field>
    </record>

 <!-- =================== Purchase Order search =================== -->
    <record id="view_purchase_order_search_ou" model="ir.ui.view">
        <field name="name">view_purchase_order_search_ou</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
             <xpath expr="//search" position="inside">
                <field name="operation_unit_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>

        </field>
    </record>
  <record id="view_purchase_order_kpis_search_ou" model="ir.ui.view">
        <field name="name">view_purchase_order_kpis_search_ou</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
             <xpath expr="//search" position="inside">
                <field name="operation_unit_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>

        </field>
    </record>


    <!-- =================== Stock Picking =================== -->
    <record id="view_stock_picking_form_ou" model="ir.ui.view">
        <field name="name">stock.picking.form.ou</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                    <field name="allow_modify_ou_flag" invisible="1"/>
                    <field name="allowed_ou_domain" invisible="1"/>
                    <field name="from_other_order" invisible="1"/>

                    <field name="operation_unit_id" force_save="1" domain="allowed_ou_domain" readonly="not allow_modify_ou_flag or from_other_order" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
         
             </xpath>
        </field>
    </record>

 

    <!-- =================== Stock Picking tree=================== -->
    <record id="view_stock_picking_out_tree_ou" model="ir.ui.view">
        <field name="name">view_stock_picking_out_tree_ou</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr = "//field[@name = 'company_id']" position="after">
                <field name="operation_unit_id"  optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>

    
    <!-- =================== Stock Picking search=================== -->
    <record id="view_stock_picking_internal_search_ou" model="ir.ui.view">
        <field name="name">view_stock_picking_internal_search_ou</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="operation_unit_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record> 
  
</odoo>
