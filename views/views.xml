<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     
   

    <!-- =================== Purchase Order =================== -->
    <record id="view_purchase_order_form_ou" model="ir.ui.view">
        <field name="name">purchase.order.form.ou</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="operation_unit_id" force_save="1"   readonly="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- =================== Stock Picking =================== -->
    <record id="view_stock_picking_form_ou" model="ir.ui.view">
        <field name="name">stock.picking.form.ou</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="operation_unit_id"  force_save="1"  readonly="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>

  
</odoo>
