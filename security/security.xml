<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>


		<record id="rule_purchase_order_ou" model="ir.rule">
			<field name="name">Purchase Order OU Rule</field>
			<field name="model_id" ref="purchase.model_purchase_order"/>
			<field name="domain_force">
				['|',('operation_unit_id','=', False),('operation_unit_id', 'in', user.ou_config_ids.allowed_ou_ids.ids)]
			</field>
		</record>

		<record id="rule_stock_picking_ou" model="ir.rule">
			<field name="name">stock picking OU Rule</field>
			<field name="model_id" ref="stock.model_stock_picking"/>
			<field name="domain_force">
				['|',('operation_unit_id','=', False),('operation_unit_id', 'in', user.ou_config_ids.allowed_ou_ids.ids)]
			</field>
		</record>
	
    </data>
</odoo>
