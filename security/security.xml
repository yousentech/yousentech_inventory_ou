<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>


		<record id="rule_purchase_order_ou" model="ir.rule">
			<field name="name">Purchase Order OU Rule</field>
			<field name="model_id" ref="purchase.model_purchase_order"/>
			<field name="domain_force">
				['|',('operation_unit_id','=', False),('operation_unit_id', 'in', user.ou_config_ids.allowed_ou_ids.ids)]
			</field>
		</record>

		<record id="rule_stock_picking_ou" model="ir.rule">
			<field name="name">stock picking OU Rule</field>
			<field name="model_id" ref="stock.model_stock_picking"/>
			<field name="domain_force">
				['|',('operation_unit_id','=', False),('operation_unit_id', 'in', user.ou_config_ids.allowed_ou_ids.ids)]
			</field>
		</record>

		
        <record model="ir.model.access" id="allow_Access_ou_valuation_layer">
            <field name="name">allow_Access_valuation_layer</field>
            <field name="model_id" ref="stock.model_stock_valuation_layer" />
             <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>
        <record id="allow_rule_ou_valuation_layer" model="ir.rule">
            <field name="name">Allow rule ou_valuation_layer</field>
            <field name="model_id" ref="stock.model_stock_valuation_layer"/>
               <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <!-- <field name="domain_force">[(1, '=', 1)]</field> -->
        </record>


	
    </data>
</odoo>
